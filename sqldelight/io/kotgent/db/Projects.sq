-- The committed UUID is stable across worktrees; path is only the most recently observed checkout.
-- Existing databases create this table in SqliteTaskStore.init; keep the DDL synchronized.
CREATE TABLE projects (
  id         TEXT NOT NULL PRIMARY KEY,
  name       TEXT NOT NULL,
  path       TEXT,
  updated_at INTEGER NOT NULL
);

upsertProject:
INSERT INTO projects(id, name, path, updated_at)
VALUES (?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
  name       = excluded.name,
  path       = coalesce(excluded.path, projects.path),
  updated_at = excluded.updated_at;

selectProject:
SELECT id, name, path, updated_at
FROM projects
WHERE id = ?;

selectAllProjects:
SELECT id, name, path, updated_at
FROM projects
ORDER BY name, id;
