-- The committed UUID is stable across worktrees; path is only the most recently observed checkout.
-- Existing databases create this table in SqliteTaskStore.init; keep the DDL synchronized.
-- `archived` is a tombstone and is deliberately absent from the upsert; only adopt or restore clears it.
CREATE TABLE projects (
  id         TEXT NOT NULL PRIMARY KEY,
  name       TEXT NOT NULL,
  path       TEXT,
  updated_at INTEGER NOT NULL,
  archived   INTEGER NOT NULL DEFAULT 0
);

upsertProject:
INSERT INTO projects(id, name, path, updated_at)
VALUES (?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
  name       = excluded.name,
  path       = coalesce(excluded.path, projects.path),
  updated_at = excluded.updated_at;

setProjectArchived:
UPDATE projects
SET archived = ?
WHERE id = ?;

selectProject:
SELECT id, name, path, updated_at, archived
FROM projects
WHERE id = ?;

selectProjectArchived:
SELECT archived
FROM projects
WHERE id = ?;

selectProjectsByArchived:
SELECT id, name, path, updated_at, archived
FROM projects
WHERE archived = ?
ORDER BY name, id;

selectAllProjects:
SELECT id, name, path, updated_at, archived
FROM projects
ORDER BY name, id;
