-- Operator choices about a directory, keyed by absolute path because folders are derived from each
-- session's cwd and have no identity of their own. Existing databases create this table in
-- SqliteEventStore.init; SQLDelight migrations are disabled.
CREATE TABLE folder_settings (
  path TEXT NOT NULL PRIMARY KEY,
  adhd INTEGER NOT NULL DEFAULT 0
);

selectAdhdPaths:
SELECT path
FROM folder_settings
WHERE adhd != 0
ORDER BY path;

markAdhd:
INSERT INTO folder_settings(path, adhd)
VALUES (?, 1)
ON CONFLICT(path) DO UPDATE SET adhd = 1;

-- Clear the column, never delete the row: the row is where this folder's other settings will live.
clearAdhd:
UPDATE folder_settings
SET adhd = 0
WHERE path = ?;
