CREATE TABLE sessions (
  id                  TEXT NOT NULL PRIMARY KEY,
  name                TEXT NOT NULL,
  tags                TEXT NOT NULL,
  agent               TEXT NOT NULL,
  provider_session_id TEXT,
  model               TEXT,
  cli_version         TEXT,
  cli_path            TEXT,
  cwd                 TEXT NOT NULL,
  repository          TEXT,
  worktree            TEXT,
  branch              TEXT,
  tmux_session        TEXT NOT NULL,
  pane_id             TEXT,
  state               TEXT NOT NULL,
  state_source        TEXT,
  last_seq            INTEGER NOT NULL,
  read_cursor         INTEGER NOT NULL,
  created_at          INTEGER NOT NULL,
  updated_at          INTEGER NOT NULL,
  archived            INTEGER NOT NULL DEFAULT 0,
  rev                 INTEGER NOT NULL DEFAULT 0,
  -- A reference, not a foreign key. SqliteEventStore is the sole writer because it owns rev and emissions.
  task_ref            TEXT,
  project_id          TEXT
);

-- Preserve UI-owned cursors and targeted task/project writes when a stale SessionMeta snapshot is upserted.
upsert:
INSERT INTO sessions(
  id, name, tags, agent, provider_session_id, model, cli_version, cli_path, cwd, repository,
  worktree, branch, tmux_session, pane_id, state, state_source, last_seq, read_cursor,
  created_at, updated_at, archived, rev, task_ref, project_id
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
  name                = excluded.name,
  tags                = excluded.tags,
  agent               = excluded.agent,
  provider_session_id = excluded.provider_session_id,
  model               = excluded.model,
  cli_version         = excluded.cli_version,
  cli_path            = excluded.cli_path,
  cwd                 = excluded.cwd,
  repository          = excluded.repository,
  worktree            = excluded.worktree,
  branch              = excluded.branch,
  tmux_session        = excluded.tmux_session,
  pane_id             = excluded.pane_id,
  state               = excluded.state,
  state_source        = excluded.state_source,
  last_seq            = excluded.last_seq,
  read_cursor         = MAX(sessions.read_cursor, excluded.read_cursor),
  created_at          = sessions.created_at,
  updated_at          = excluded.updated_at,
  archived            = excluded.archived,
  rev                 = excluded.rev,
  task_ref            = coalesce(excluded.task_ref, sessions.task_ref),
  project_id          = coalesce(excluded.project_id, sessions.project_id);

updateCache:
UPDATE sessions
SET state = ?, state_source = ?, last_seq = ?, provider_session_id = ?, updated_at = ?, rev = ?
WHERE id = ?;

updateControlState:
UPDATE sessions
SET state = ?, state_source = ?, pane_id = ?, updated_at = ?, rev = ?
WHERE id = ?;

setArchived:
UPDATE sessions
SET archived = ?, updated_at = ?, rev = ?
WHERE id = ?;

-- Monotonic and clamped. SQLDelight infers the MIN operand as nullable, so callers must never bind null.
setReadCursor:
UPDATE sessions
SET read_cursor = MAX(read_cursor, MIN(?, last_seq)), rev = ?
WHERE id = ?;

-- Derived metadata mutators advance rev but leave updated_at to activity-owning writes.
setModel:
UPDATE sessions
SET model = ?, rev = ?
WHERE id = ?;

-- Atomic id check prevents a slow model scan from writing past a provider-id rebind.
setModelForProvider:
UPDATE sessions
SET model = ?, rev = ?
WHERE id = ? AND provider_session_id = ?;

-- Unconditional: multiple sessions may legitimately link to the same task.
setTaskRef:
UPDATE sessions
SET task_ref = ?, rev = ?
WHERE id = ?;

-- Lost-update guard: a clear must not erase a newer link that replaced the one the caller observed.
clearTaskRefIf:
UPDATE sessions
SET task_ref = NULL, rev = ?
WHERE id = ? AND task_ref = ?;

setProjectId:
UPDATE sessions
SET project_id = ?, rev = ?
WHERE id = ?;

sessionsHoldingTask:
SELECT *
FROM sessions
WHERE task_ref = ?
ORDER BY created_at, id;

get:
SELECT *
FROM sessions
WHERE id = ?;

list:
SELECT *
FROM sessions
ORDER BY created_at, id;

maxRev:
SELECT coalesce(MAX(rev), 0)
FROM sessions;
