-- The sessions read-model cache (Task 7) — one row per session, mirroring io.kotgent.core.SessionMeta
-- in `sessions`-column order. Identity + launch/tmux/repo context is owned by the daemon (upsert),
-- while the reducer-derived cache fields (state, state_source, last_seq, provider_session_id,
-- updated_at) are advanced by EventStore.append IN THE SAME transaction as the event insert, so the
-- cache is always consistent with the log. `tags` is a JSON array of strings; nullable columns stay
-- null until discovered (provider_session_id after SessionBound, pane_id after tmux new-session, ...).
CREATE TABLE sessions (
  id                  TEXT NOT NULL PRIMARY KEY,
  name                TEXT NOT NULL,
  tags                TEXT NOT NULL,
  agent               TEXT NOT NULL,
  provider_session_id TEXT,
  model               TEXT,
  cli_version         TEXT,
  cli_path            TEXT,
  cwd                 TEXT NOT NULL,
  repository          TEXT,
  worktree            TEXT,
  branch              TEXT,
  tmux_session        TEXT NOT NULL,
  pane_id             TEXT,
  state               TEXT NOT NULL,
  state_source        TEXT,
  last_seq            INTEGER NOT NULL,
  read_cursor         INTEGER NOT NULL,
  created_at          INTEGER NOT NULL,
  updated_at          INTEGER NOT NULL,
  -- Orthogonal "hidden from the working set" flag (a "Done" session). Never touched by the reducer or
  -- the control-state writes; set only via setArchived. Declared LAST so create() matches the additive
  -- `ALTER TABLE ... ADD COLUMN archived` migration SqliteEventStore.init runs for pre-existing DBs.
  archived            INTEGER NOT NULL DEFAULT 0
);

-- Full-row upsert (daemon-owned session metadata). On conflict, every field is refreshed from the
-- new row EXCEPT created_at, which is preserved from the existing row, and read_cursor, which is
-- max-merged: the cursor is UI-owned (setReadCursor) and advances outside any SessionMeta the daemon
-- holds, so a caller writing a stale snapshot must never regress it and resurrect a cleared badge.
-- DEFENCE IN DEPTH, not a live race — this is the record of that, for the code that points here: neither
-- caller can carry a stale cursor today (SessionManager.start inserts a fresh row; Reconciler.reconcile
-- runs ONCE at daemon start, before the server binds, over metas it read moments earlier), so the MAX
-- always selects sessions.read_cursor. It guards a future periodic or concurrent reconciler.
upsert:
INSERT INTO sessions(
  id, name, tags, agent, provider_session_id, model, cli_version, cli_path, cwd, repository,
  worktree, branch, tmux_session, pane_id, state, state_source, last_seq, read_cursor,
  created_at, updated_at, archived
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
  name                = excluded.name,
  tags                = excluded.tags,
  agent               = excluded.agent,
  provider_session_id = excluded.provider_session_id,
  model               = excluded.model,
  cli_version         = excluded.cli_version,
  cli_path            = excluded.cli_path,
  cwd                 = excluded.cwd,
  repository          = excluded.repository,
  worktree            = excluded.worktree,
  branch              = excluded.branch,
  tmux_session        = excluded.tmux_session,
  pane_id             = excluded.pane_id,
  state               = excluded.state,
  state_source        = excluded.state_source,
  last_seq            = excluded.last_seq,
  read_cursor         = MAX(sessions.read_cursor, excluded.read_cursor),
  created_at          = sessions.created_at,
  updated_at          = excluded.updated_at,
  archived            = excluded.archived;

-- Advance ONLY the reducer-derived cache fields; called inside EventStore.append's transaction
-- (leaves identity/launch context and read_cursor untouched).
updateCache:
UPDATE sessions
SET state = ?, state_source = ?, last_seq = ?, provider_session_id = ?, updated_at = ?
WHERE id = ?;

-- Update ONLY the daemon-owned control fields (state, state_source, pane_id, updated_at) for a
-- control op (stop/interrupt/resume) or a reconciler reclassification. Critically it does NOT touch
-- last_seq or provider_session_id, which are advanced by EventStore.append under its own lock — a
-- full-row upsert here would clobber a concurrent hook append's last_seq / provider_session_id.
updateControlState:
UPDATE sessions
SET state = ?, state_source = ?, pane_id = ?, updated_at = ?
WHERE id = ?;

-- Set ONLY the orthogonal archived flag (and updated_at). Never touches state/last_seq/provider id.
setArchived:
UPDATE sessions
SET archived = ?, updated_at = ?
WHERE id = ?;

-- Advance ONLY the read cursor; never touches state/last_seq/provider id or updated_at (viewing is not
-- activity, and `kotgent list` sorts by updated_at). The monotonic + clamped contract EventStore.markRead
-- states is implemented here, so any caller gets it: MAX(read_cursor, …) never regresses, MIN(?, last_seq)
-- never overshoots the log. Both are SQLite's 2-argument SCALAR functions and both read pre-update values.
-- NOTE: SQLDelight infers a MIN() operand as nullable, so the signature is setReadCursor(value: Long?, id:
-- String) — and binding null would evaluate the SET to NULL and violate NOT NULL at runtime. Keep every
-- caller on a non-null Long (markRead's Seq is). The named-parameter form infers the same, so it is no fix.
setReadCursor:
UPDATE sessions
SET read_cursor = MAX(read_cursor, MIN(?, last_seq))
WHERE id = ?;

-- Set ONLY the discovered model (and updated_at). Best-effort, once per session; never touches state.
setModel:
UPDATE sessions
SET model = ?, updated_at = ?
WHERE id = ?;

get:
SELECT *
FROM sessions
WHERE id = ?;

list:
SELECT *
FROM sessions
ORDER BY created_at, id;
