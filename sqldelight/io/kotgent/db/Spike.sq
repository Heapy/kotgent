-- Storage spike (Task 4): a trivial schema + insert/select queries. The sqldelight-gen plugin
-- generates typed Kotlin from this file; the round-trip test drives the generated API against
-- SQLDelight's native-driver (in-memory SQLite) on macosArm64.
CREATE TABLE spike (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  value TEXT NOT NULL
);

insertValue:
INSERT INTO spike(value)
VALUES (?);

selectLatest:
SELECT value
FROM spike
ORDER BY id DESC
LIMIT 1;
