-- The tracker's own rows plus each task's append-only activity feed (the task-backlog plan).
--
-- `tasks` is deliberately narrow: it is what ANY tracker, local or external, can answer about a task.
-- The workflow (state, ordering, dependencies) lives in Backlog.sq, keyed by the same `task_ref`. There
-- is no `url` column: io.kotgent.task.Task carries one for a future external tracker, and TaskTracker
-- exposes no setter for it, so the built-in tracker always reports null.
--
-- NOTE for pre-existing databases: the sqldelight-gen plugin drops `.sqm` files and leaves the generated
-- `Schema.migrate()` empty, so these CREATEs only run on a FRESH database. An existing
-- `~/.kotgent/kotgent.db` gets them from the `CREATE TABLE IF NOT EXISTS` block in
-- io.kotgent.store.SqliteTaskStore's init — a whole-table create needs no `PRAGMA table_info` guard
-- (`IF NOT EXISTS` neither fails nor logs, unlike a duplicate-column ALTER). Keep the two in exact step.
CREATE TABLE tasks (
  id         TEXT NOT NULL PRIMARY KEY,
  title      TEXT NOT NULL,
  body       TEXT NOT NULL DEFAULT '',
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL
);

-- One row per activity event. `id` is the feed's order (append-only, never rewritten); `kind` is an
-- io.kotgent.task.ActivityKind name; `from_state`/`to_state` are set only for a `transition`. The feed
-- is fetched with the task detail and deliberately does NOT ride the events socket.
CREATE TABLE task_activity (
  id         INTEGER PRIMARY KEY AUTOINCREMENT,
  task_ref   TEXT NOT NULL,
  ts         INTEGER NOT NULL,
  kind       TEXT NOT NULL,
  author     TEXT NOT NULL,
  text       TEXT,
  from_state TEXT,
  to_state   TEXT
);

CREATE INDEX task_activity_by_task ON task_activity(task_ref, id);

-- The built-in tracker's key allocator: ONE row (`id` fixed at 0) holding the highest `local:<n>` this
-- database has EVER minted.
--
-- Why a table rather than `MAX(...)` over `tasks`: `maxLocalTaskKey` below answers over the SURVIVING
-- rows, and deleting the newest task takes the maximum with it — so a store reopened after that delete
-- re-issues the freed key. A ref is not a private handle: it reaches URLs (`/tasks/local:2`), a
-- notification, an operator's bookmark, a script, `sessions.task_ref` and an agent's own earlier output,
-- so the second `local:2` silently re-points every one of those at unrelated work. This row therefore
-- only ever RISES; `deleteTask` does not touch it, and the one statement that writes it takes a `max`.
CREATE TABLE task_local_keys (
  id     INTEGER NOT NULL PRIMARY KEY,
  minted INTEGER NOT NULL
);

-- --- tasks -------------------------------------------------------------------------------------

insertTask:
INSERT INTO tasks(id, title, body, created_at, updated_at)
VALUES (?, ?, ?, ?, ?);

selectTask:
SELECT id, title, body, created_at, updated_at
FROM tasks
WHERE id = ?;

-- Every task in one project, tracker fields only (the backlog owns ordering, so no ORDER BY position
-- here). TaskTracker.list's query.
selectTasksByProject:
SELECT t.id, t.title, t.body, t.created_at, t.updated_at
FROM tasks t
JOIN backlog_entries b ON b.task_ref = t.id
WHERE b.project = ?
ORDER BY t.id;

-- A null argument means "leave unchanged", never "clear": both columns are NOT NULL and a PATCH that
-- omits one must not blank it (TaskTracker.update's contract). COALESCE is what implements that, so the
-- read and the write stay one statement.
updateTaskFields:
UPDATE tasks
SET title = coalesce(?, title), body = coalesce(?, body), updated_at = ?
WHERE id = ?;

deleteTask:
DELETE FROM tasks
WHERE id = ?;

-- The highest numeric key the built-in tracker's SURVIVING rows show. Refs are text, so the cast is
-- explicit; a non-numeric key (a ref adopted from another tracker) casts to 0 and cannot push the
-- counter backwards. The literal prefix is io.kotgent.core.TaskRef.LOCAL_TRACKER plus ':' — 6 characters,
-- hence substr(id, 7); keep the two in step if that constant ever changes.
--
-- This is the MIGRATION SEED for `task_local_keys`, not the allocator: it is read exactly once per store
-- open, to raise the high-water mark of a database written before that table existed. Allocating from it
-- directly is the bug the table exists for — a delete removes the row carrying the maximum.
maxLocalTaskKey:
SELECT coalesce(MAX(CAST(substr(id, 7) AS INTEGER)), 0)
FROM tasks
WHERE id LIKE 'local:%';

-- --- the local key allocator ---------------------------------------------------------------------

-- Raise the high-water mark to :minted, creating the singleton row for a database that predates it.
-- `max` is what makes the write monotone whatever the caller passed, and both callers depend on it: the
-- seed at store open supplies the highest key the tracker's own rows still show (so an old database
-- migrates without ever lowering a mark it already holds), and an allocation supplies the key it is
-- about to write. Neither may move the mark down, and nothing else writes this table at all.
raiseLocalKeyHighWater:
INSERT INTO task_local_keys(id, minted)
VALUES (0, ?)
ON CONFLICT(id) DO UPDATE SET minted = max(task_local_keys.minted, excluded.minted);

-- The high-water mark; 0 for a database that has never minted a key. Read once per store open, into the
-- in-memory counter that hands out keys under the writer mutex — an allocation never re-reads it, so two
-- concurrent creates cannot collide on a key while the second one's SELECT still sees the pre-insert
-- value. It is read inside the same transaction as the seed above for the `lastActivityId` reason: a
-- transaction-less SELECT is answered by the driver's reader pool, which cannot see an uncommitted write.
localKeyHighWater:
SELECT coalesce(MAX(minted), 0)
FROM task_local_keys
WHERE id = 0;

-- --- activity ----------------------------------------------------------------------------------

insertActivity:
INSERT INTO task_activity(task_ref, ts, kind, author, text, from_state, to_state)
VALUES (?, ?, ?, ?, ?, ?, ?);

-- The row id the last insert on THIS CONNECTION produced — the feed's order key, echoed back into the
-- returned TaskActivityEntry.
--
-- CONTRACT, and it is not the obvious one: this must be read inside the SAME `db.transaction { }` as the
-- insertActivity whose id it is asking about. Holding the store's writer mutex is necessary and NOT
-- sufficient. SQLDelight generates this as an ExecutableQuery (it starts with SELECT), and the native
-- driver routes a query with no transaction bound to the calling thread to its READER POOL — separate
-- connections it opens with `PRAGMA query_only = 1`, which have never inserted anything, so the answer is
-- 0 and every activity row comes back with id 0. Inside a transaction the driver has a connection
-- thread-aligned to the caller (`borrowedConnectionThread`) and both statements run on it, which is what
-- makes the rowid the insert's own.
--
-- The trap has a second half: for an EPHEMERAL database the driver sets `readerPool = transactionPool`
-- (one connection), so a test over SqliteTaskStore.inMemory() answers correctly with or without the
-- transaction. Only the daemon's file-backed database exposes the bug. Do not "verify" this rule against
-- an in-memory store.
lastActivityId:
SELECT last_insert_rowid();

selectActivity:
SELECT id, task_ref, ts, kind, author, text, from_state, to_state
FROM task_activity
WHERE task_ref = ?
ORDER BY id;

deleteActivityForTask:
DELETE FROM task_activity
WHERE task_ref = ?;
