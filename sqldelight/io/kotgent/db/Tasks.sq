-- Existing databases create these tables in SqliteTaskStore.init; keep the two DDL definitions synchronized.
CREATE TABLE tasks (
  id         TEXT NOT NULL PRIMARY KEY,
  title      TEXT NOT NULL,
  body       TEXT NOT NULL DEFAULT '',
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL
);

CREATE TABLE task_activity (
  id         INTEGER PRIMARY KEY AUTOINCREMENT,
  task_ref   TEXT NOT NULL,
  ts         INTEGER NOT NULL,
  kind       TEXT NOT NULL,
  author     TEXT NOT NULL,
  text       TEXT,
  from_state TEXT,
  to_state   TEXT
);

CREATE INDEX task_activity_by_task ON task_activity(task_ref, id);

-- Persisted high-water mark: deleting the newest task must never allow reuse of its public `local:<n>` ref.
CREATE TABLE task_local_keys (
  id     INTEGER NOT NULL PRIMARY KEY,
  minted INTEGER NOT NULL
);


insertTask:
INSERT INTO tasks(id, title, body, created_at, updated_at)
VALUES (?, ?, ?, ?, ?);

selectTask:
SELECT id, title, body, created_at, updated_at
FROM tasks
WHERE id = ?;

selectTasksByProject:
SELECT t.id, t.title, t.body, t.created_at, t.updated_at
FROM tasks t
JOIN backlog_entries b ON b.task_ref = t.id
WHERE b.project = ?
ORDER BY t.id;

updateTaskFields:
UPDATE tasks
SET title = coalesce(?, title), body = coalesce(?, body), updated_at = ?
WHERE id = ?;

deleteTask:
DELETE FROM tasks
WHERE id = ?;

-- Migration seed only; allocation uses task_local_keys because this maximum falls when tasks are deleted.
maxLocalTaskKey:
SELECT coalesce(MAX(CAST(substr(id, 7) AS INTEGER)), 0)
FROM tasks
WHERE id LIKE 'local:%';


raiseLocalKeyHighWater:
INSERT INTO task_local_keys(id, minted)
VALUES (0, ?)
ON CONFLICT(id) DO UPDATE SET minted = max(task_local_keys.minted, excluded.minted);

localKeyHighWater:
SELECT coalesce(MAX(minted), 0)
FROM task_local_keys
WHERE id = 0;


insertActivity:
INSERT INTO task_activity(task_ref, ts, kind, author, text, from_state, to_state)
VALUES (?, ?, ?, ?, ?, ?, ?);

-- Must run in the insert's transaction. Outside one, the native driver uses a reader connection whose
-- last_insert_rowid() is 0; an in-memory database cannot expose that distinction.
lastActivityId:
SELECT last_insert_rowid();

selectActivity:
SELECT id, task_ref, ts, kind, author, text, from_state, to_state
FROM task_activity
WHERE task_ref = ?
ORDER BY id;

deleteActivityForTask:
DELETE FROM task_activity
WHERE task_ref = ?;
