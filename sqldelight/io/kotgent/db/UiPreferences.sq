-- One daemon-wide Web UI preference row. There are no user identities in kotgent's authentication
-- model, so the singleton is intentionally shared by every connected browser.
--
-- NOTE for pre-existing databases: the sqldelight-gen plugin drops `.sqm` files and leaves the
-- generated `Schema.migrate()` empty. A legacy `kotgent.db` gets this table from the matching
-- `CREATE TABLE IF NOT EXISTS` in SqliteEventStore.init, followed by seedDefaults below.
CREATE TABLE ui_preferences (
  singleton      INTEGER NOT NULL PRIMARY KEY CHECK (singleton = 1),
  base_path      TEXT NOT NULL,
  grouping_level INTEGER NOT NULL,
  revision       INTEGER NOT NULL
);

seedDefaults:
INSERT OR IGNORE INTO ui_preferences(singleton, base_path, grouping_level, revision)
VALUES (1, '', 1, 0);

selectCurrent:
SELECT base_path, grouping_level, revision
FROM ui_preferences
WHERE singleton = 1;

save:
UPDATE ui_preferences
SET base_path = ?, grouping_level = ?, revision = revision + 1
WHERE singleton = 1;
