-- Existing databases create and seed this table in SqliteEventStore.init; SQLDelight migrations are disabled.
CREATE TABLE ui_preferences (
  singleton      INTEGER NOT NULL PRIMARY KEY CHECK (singleton = 1),
  base_path      TEXT NOT NULL,
  grouping_level INTEGER NOT NULL,
  revision       INTEGER NOT NULL
);

seedDefaults:
INSERT OR IGNORE INTO ui_preferences(singleton, base_path, grouping_level, revision)
VALUES (1, '', 1, 0);

selectCurrent:
SELECT base_path, grouping_level, revision
FROM ui_preferences
WHERE singleton = 1;

save:
UPDATE ui_preferences
SET base_path = ?, grouping_level = ?, revision = revision + 1
WHERE singleton = 1;
