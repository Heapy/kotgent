-- Existing databases create these additive tables in SqliteUsageStore.init; keep the DDL synchronized.
CREATE TABLE usage_windows (
  provider TEXT NOT NULL,
  window_key TEXT NOT NULL,
  used_percent REAL NOT NULL,
  resets_at INTEGER,
  window_seconds INTEGER,
  observed_at INTEGER NOT NULL,
  changed_at INTEGER NOT NULL,
  source_id TEXT,
  source_revision INTEGER,
  source_captured_at INTEGER,
  reset_generation INTEGER NOT NULL DEFAULT 0,
  admitted_capture_at INTEGER NOT NULL DEFAULT 0,
  prev_used_percent REAL,
  prev_resets_at INTEGER,
  prev_window_seconds INTEGER,
  prev_observed_at INTEGER,
  prev_source_id TEXT,
  prev_source_revision INTEGER,
  prev_source_captured_at INTEGER,
  PRIMARY KEY (provider, window_key)
);

CREATE TABLE usage_sources (
  provider TEXT NOT NULL,
  window_key TEXT NOT NULL,
  source_id TEXT NOT NULL,
  source_revision INTEGER NOT NULL,
  source_captured_at INTEGER NOT NULL,
  used_percent REAL NOT NULL,
  resets_at INTEGER,
  window_seconds INTEGER,
  baseline_reset_generation INTEGER NOT NULL,
  PRIMARY KEY (provider, window_key, source_id)
);

CREATE TABLE usage_samples (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  provider TEXT NOT NULL,
  window_key TEXT NOT NULL,
  used_percent REAL NOT NULL,
  resets_at INTEGER,
  window_seconds INTEGER,
  observed_at INTEGER NOT NULL,
  source_id TEXT,
  source_revision INTEGER,
  source_captured_at INTEGER
);

CREATE INDEX usage_samples_by_window ON usage_samples(provider, window_key, observed_at);

CREATE TABLE usage_resets (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  provider TEXT NOT NULL,
  window_key TEXT NOT NULL,
  expected_at INTEGER,
  observed_at INTEGER NOT NULL,
  used_before REAL NOT NULL,
  used_before_seen_at INTEGER NOT NULL,
  early INTEGER NOT NULL,
  resets_at_moved INTEGER NOT NULL,
  window_seconds INTEGER,
  inbox_projected INTEGER NOT NULL DEFAULT 0
);

selectAllWindows:
SELECT * FROM usage_windows ORDER BY provider, window_key;

selectWindow:
SELECT * FROM usage_windows WHERE provider = ? AND window_key = ?;

upsertWindow:
INSERT INTO usage_windows (
  provider, window_key, used_percent, resets_at, window_seconds, observed_at, changed_at,
  source_id, source_revision, source_captured_at, reset_generation, admitted_capture_at,
  prev_used_percent, prev_resets_at, prev_window_seconds, prev_observed_at,
  prev_source_id, prev_source_revision, prev_source_captured_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(provider, window_key) DO UPDATE SET
  used_percent = excluded.used_percent,
  resets_at = excluded.resets_at,
  window_seconds = excluded.window_seconds,
  observed_at = excluded.observed_at,
  changed_at = excluded.changed_at,
  source_id = excluded.source_id,
  source_revision = excluded.source_revision,
  source_captured_at = excluded.source_captured_at,
  reset_generation = excluded.reset_generation,
  admitted_capture_at = excluded.admitted_capture_at,
  prev_used_percent = excluded.prev_used_percent,
  prev_resets_at = excluded.prev_resets_at,
  prev_window_seconds = excluded.prev_window_seconds,
  prev_observed_at = excluded.prev_observed_at,
  prev_source_id = excluded.prev_source_id,
  prev_source_revision = excluded.prev_source_revision,
  prev_source_captured_at = excluded.prev_source_captured_at;

selectSource:
SELECT * FROM usage_sources WHERE provider = ? AND window_key = ? AND source_id = ?;

updateAdmittedCapture:
UPDATE usage_windows SET admitted_capture_at = ? WHERE provider = ? AND window_key = ?;

upsertSource:
INSERT INTO usage_sources (
  provider, window_key, source_id, source_revision, source_captured_at,
  used_percent, resets_at, window_seconds, baseline_reset_generation
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(provider, window_key, source_id) DO UPDATE SET
  source_revision = excluded.source_revision,
  source_captured_at = excluded.source_captured_at,
  used_percent = excluded.used_percent,
  resets_at = excluded.resets_at,
  window_seconds = excluded.window_seconds,
  baseline_reset_generation = excluded.baseline_reset_generation;

insertSample:
INSERT INTO usage_samples (
  provider, window_key, used_percent, resets_at, window_seconds, observed_at,
  source_id, source_revision, source_captured_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

insertReset:
INSERT INTO usage_resets (
  provider, window_key, expected_at, observed_at, used_before, used_before_seen_at,
  early, resets_at_moved, window_seconds
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

lastResetId:
SELECT last_insert_rowid();

selectPendingResets:
SELECT id, provider, window_key, expected_at, observed_at, used_before, used_before_seen_at,
       early, resets_at_moved, window_seconds
FROM usage_resets
WHERE inbox_projected = 0 AND early = 1 AND observed_at >= ?
  AND ((provider = 'claude' AND window_key = 'seven_day')
       OR (provider = 'codex' AND window_seconds = 604800))
ORDER BY id;

markResetProjected:
UPDATE usage_resets SET inbox_projected = 1 WHERE id = ?;

pruneSamples:
DELETE FROM usage_samples WHERE observed_at < ?;

pruneResets:
DELETE FROM usage_resets WHERE observed_at < ?;

pruneSources:
DELETE FROM usage_sources WHERE source_captured_at < ?;
