-- `blocked` is derived; dependency and state changes re-stamp reverse dependents so live clients update.
-- Existing databases create these tables in SqliteTaskStore.init; keep the two DDL definitions synchronized.
CREATE TABLE backlog_entries (
  task_ref   TEXT NOT NULL PRIMARY KEY,
  project    TEXT NOT NULL,
  position   REAL NOT NULL,
  state      TEXT NOT NULL,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  rev        INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX backlog_entries_by_project ON backlog_entries(project, position);

-- `task_ref` depends on `depends_on`; insertion validates existence, project equality, self, and cycles.
CREATE TABLE backlog_deps (
  task_ref   TEXT NOT NULL,
  depends_on TEXT NOT NULL,
  PRIMARY KEY (task_ref, depends_on)
);

CREATE INDEX backlog_deps_by_dependency ON backlog_deps(depends_on, task_ref);


selectEntry:
SELECT task_ref, project, position, state, created_at, updated_at, rev
FROM backlog_entries
WHERE task_ref = ?;

selectEntriesByProject:
SELECT task_ref, project, position, state, created_at, updated_at, rev
FROM backlog_entries
WHERE project = ?
ORDER BY position, task_ref;

selectBacklogWithTasks:
SELECT b.task_ref, b.project, b.position, b.state, b.created_at, b.updated_at, b.rev, t.title, t.body
FROM backlog_entries b
JOIN tasks t ON t.id = b.task_ref
WHERE b.project = ?
ORDER BY b.position, b.task_ref;

-- The tombstone clause is what makes `POST /tasks/next` refuse a deleted project ATOMICALLY. The route
-- reads the project row first, for the message, but it holds no lock afterwards; a delete landing
-- between that read and this query would otherwise hand out work from a project the board no longer
-- lists. One statement cannot be interleaved, so selection is closed here rather than re-checked there.
-- A project with NO row is left alone deliberately: absence is not a tombstone, and only `archived <> 0`
-- withdraws a backlog.
nextCandidate:
SELECT b.task_ref, b.project, b.position, b.state, b.created_at, b.updated_at, b.rev
FROM backlog_entries b
WHERE b.project = ?
  AND b.state = 'todo'
  AND NOT EXISTS (
    SELECT 1
    FROM projects p
    WHERE p.id = b.project AND p.archived <> 0
  )
  AND NOT EXISTS (
    SELECT 1
    FROM backlog_deps d
    JOIN backlog_entries e ON e.task_ref = d.depends_on
    WHERE d.task_ref = b.task_ref AND e.state <> 'done'
  )
ORDER BY b.position, b.task_ref
LIMIT 1;

unfinishedDependencyCount:
SELECT count(*)
FROM backlog_deps d
JOIN backlog_entries e ON e.task_ref = d.depends_on
WHERE d.task_ref = ? AND e.state <> 'done';

maxRev:
SELECT coalesce(MAX(rev), 0)
FROM backlog_entries;

maxPosition:
SELECT MAX(position)
FROM backlog_entries
WHERE project = ?;

minPosition:
SELECT MIN(position)
FROM backlog_entries
WHERE project = ?;

neighboursAround:
SELECT MAX(CASE WHEN position < :position THEN position END) AS below,
       MIN(CASE WHEN position > :position THEN position END) AS above
FROM backlog_entries
WHERE project = :project;


insertEntry:
INSERT INTO backlog_entries(task_ref, project, position, state, created_at, updated_at, rev)
VALUES (?, ?, ?, ?, ?, ?, ?);

setState:
UPDATE backlog_entries
SET state = ?, updated_at = ?, rev = ?
WHERE task_ref = ?;

-- A selection convention for `task next`, not exclusivity: zero rows is normal and linking still proceeds.
-- This is the DEFERENCE form, used for a card the caller NAMED (`POST /tasks/{ref}/link`): a tombstone
-- withdraws a project as a SOURCE of work, and naming a ref is not selecting one, so it deliberately
-- carries no tombstone clause.
startIfTodo:
UPDATE backlog_entries
SET state = 'in_progress', updated_at = ?, rev = ?
WHERE task_ref = ? AND state = 'todo';

-- The SELECTION form, used only by `POST /tasks/next`. It is `nextCandidate`'s tombstone clause applied
-- one step later, for the same reason: `linkNext` picks a card and starts it as two store calls, so a
-- delete landing between them would otherwise let the daemon CHOOSE work out of a project the board no
-- longer lists — precisely the outcome the route's refusal exists to prevent. Deciding it in the writing
-- statement makes selection and start each atomic against the tombstone; zero rows is what `linkNext`'s
-- loop already treats as "somebody else took it, re-query", and the re-query then finds no candidate at
-- all and answers the ordinary `{"task":null}`.
startIfTodoInLiveProject:
UPDATE backlog_entries
SET state = 'in_progress', updated_at = ?, rev = ?
WHERE task_ref = ? AND state = 'todo'
  AND NOT EXISTS (
    SELECT 1
    FROM projects p
    WHERE p.id = backlog_entries.project AND p.archived <> 0
  );

setPosition:
UPDATE backlog_entries
SET position = ?, updated_at = ?, rev = ?
WHERE task_ref = ?;

-- Derived-state notification only; do not turn it into user-visible activity.
restamp:
UPDATE backlog_entries
SET rev = ?
WHERE task_ref = ?;

deleteEntry:
DELETE FROM backlog_entries
WHERE task_ref = ?;


insertDep:
INSERT OR IGNORE INTO backlog_deps(task_ref, depends_on)
VALUES (?, ?);

deleteDep:
DELETE FROM backlog_deps
WHERE task_ref = ? AND depends_on = ?;

deleteDepsForTask:
DELETE FROM backlog_deps
WHERE task_ref = ? OR depends_on = ?;

selectDependencies:
SELECT depends_on
FROM backlog_deps
WHERE task_ref = ?
ORDER BY depends_on;

selectDependents:
SELECT task_ref
FROM backlog_deps
WHERE depends_on = ?
ORDER BY task_ref;

selectDependencyEdges:
SELECT d.task_ref, d.depends_on
FROM backlog_deps d
JOIN backlog_entries b ON b.task_ref = d.task_ref
WHERE b.project = ?
ORDER BY d.task_ref, d.depends_on;
