# Platform details stay in C: libc's opaque spawn types and stat layouts differ across targets.

package = io.kotgent.cinterop.pty
headers = sys/ioctl.h termios.h
compilerOpts.linux = -D_GNU_SOURCE
linkerOpts.linux = -lutil -ldl

---

#ifdef __APPLE__
#include <util.h>
#include <mach-o/dyld.h>
#else
#include <pty.h>
#include <dlfcn.h>
#endif
#include <sys/ioctl.h>
#include <termios.h>
#include <spawn.h>
#include <signal.h>
#include <sys/stat.h>
#include <unistd.h>
#include <fcntl.h>
#include <errno.h>
#include <stdlib.h>
#include <string.h>
#include <limits.h>
#include <stdint.h>

// Kotlin/Native ships older glibc headers. This ABI flag has been stable since glibc 2.26;
// Linux releases require glibc 2.35+ and resolve the newer close-from action at runtime.
#ifndef POSIX_SPAWN_SETSID
#define POSIX_SPAWN_SETSID 0x80
#endif

static int kotgent_spawn_pty(int *child, const char *pts_path, char *const argv[], char *const envp[],
                             int *actions_cleanup, int *attr_cleanup) {
    *actions_cleanup = 0;
    *attr_cleanup = 0;
    posix_spawn_file_actions_t actions;
    int rc = posix_spawn_file_actions_init(&actions);
    if (rc) return rc;
    // O_NOCTTY keeps the same explicit SIGWINCH contract on both hosts.
    rc = posix_spawn_file_actions_addopen(&actions, 0, pts_path, O_RDWR | O_NOCTTY, 0);
    if (!rc) rc = posix_spawn_file_actions_adddup2(&actions, 0, 1);
    if (!rc) rc = posix_spawn_file_actions_adddup2(&actions, 0, 2);
    short flags = POSIX_SPAWN_SETSID;
#ifdef __APPLE__
    flags |= POSIX_SPAWN_CLOEXEC_DEFAULT;
#else
    typedef int (*closefrom_fn)(posix_spawn_file_actions_t *, int);
    closefrom_fn closefrom_action = (closefrom_fn)dlsym(RTLD_DEFAULT, "posix_spawn_file_actions_addclosefrom_np");
    if (!rc) rc = closefrom_action ? closefrom_action(&actions, 3) : ENOSYS;
#endif
    if (rc) {
        *actions_cleanup = posix_spawn_file_actions_destroy(&actions);
        return rc;
    }
    posix_spawnattr_t attr;
    rc = posix_spawnattr_init(&attr);
    if (!rc) {
        rc = posix_spawnattr_setflags(&attr, flags);
        if (!rc) rc = posix_spawn(child, argv[0], &actions, &attr, argv, envp);
        *attr_cleanup = posix_spawnattr_destroy(&attr);
    }
    *actions_cleanup = posix_spawn_file_actions_destroy(&actions);
    return rc;
}

// cinterop does not surface util.h's openpty declaration, so expose it from the compiled body.
static int kotgent_openpty(int *amaster, int *aslave) {
    return openpty(amaster, aslave, (char *)0, (struct termios *)0, (struct winsize *)0);
}

// Keep variadic ioctl and the macro-expanded TIOCSWINSZ outside Kotlin cinterop.
static int kotgent_set_winsize(int fd, unsigned short rows, unsigned short cols) {
    struct winsize ws;
    ws.ws_row = rows;
    ws.ws_col = cols;
    ws.ws_xpixel = 0;
    ws.ws_ypixel = 0;
    return ioctl(fd, TIOCSWINSZ, &ws);
}

// ptsname is also absent from the header scan. The child opens this path itself; the spawn file
// action does not make it a controlling tty, so Pty.resize explicitly delivers SIGWINCH.
static int kotgent_ptsname(int master, char *buf, unsigned int buflen) {
    const char *name = ptsname(master);
    if (name == (char *)0) return -1;
    size_t n = strlen(name);
    if (n + 1 > (size_t)buflen) return -1;
    memcpy(buf, name, n + 1);
    return 0;
}

// Kotlin cannot materialize these opaque structs. One process owns one attach tty, so one saved
// process-wide termios value is sufficient.

static struct termios kotgent_saved_termios;
static int kotgent_saved_termios_valid = 0;

static int kotgent_tty_enter_raw(int fd) {
    if (tcgetattr(fd, &kotgent_saved_termios) != 0) return -1;
    kotgent_saved_termios_valid = 1;
    struct termios raw = kotgent_saved_termios;
    cfmakeraw(&raw);
    return tcsetattr(fd, TCSANOW, &raw);
}

// Safe to call unconditionally on exit; no saved termios is a successful no-op.
static int kotgent_tty_restore(int fd) {
    if (!kotgent_saved_termios_valid) return 0;
    return tcsetattr(fd, TCSAFLUSH, &kotgent_saved_termios);
}

static int kotgent_get_winsize(int fd, unsigned short *rows, unsigned short *cols) {
    struct winsize ws;
    if (ioctl(fd, TIOCGWINSZ, &ws) != 0) return -1;
    *rows = ws.ws_row;
    *cols = ws.ws_col;
    return 0;
}

// Canonical executable location is also the anchor for the installed Web UI resource tree.
static int kotgent_executable_path(char *buf, unsigned int buflen) {
    char raw[PATH_MAX];
#ifdef __APPLE__
    uint32_t size = (uint32_t)sizeof(raw);
    if (_NSGetExecutablePath(raw, &size) != 0) return -1;
#else
    ssize_t size = readlink("/proc/self/exe", raw, sizeof(raw));
    if (size < 0 || size >= (ssize_t)sizeof(raw)) return -1;
    raw[size] = '\0';
#endif
    char resolved[PATH_MAX];
    const char *src = realpath(raw, resolved) ? resolved : raw;
    size_t n = strlen(src);
    if (n + 1 > (size_t)buflen) return -1;
    memcpy(buf, src, n + 1);
    return 0;
}

static int kotgent_file_times(const char *path, int64_t *modified, int64_t *birth) {
    struct stat st;
    if (stat(path, &st) != 0) return -1;
#ifdef __APPLE__
    *modified = (int64_t)st.st_mtimespec.tv_sec * 1000 + st.st_mtimespec.tv_nsec / 1000000;
    *birth = (int64_t)st.st_birthtimespec.tv_sec * 1000 + st.st_birthtimespec.tv_nsec / 1000000;
#else
    *modified = (int64_t)st.st_mtim.tv_sec * 1000 + st.st_mtim.tv_nsec / 1000000;
    // stat(2) has no creation time on Linux. ctime is a metadata change, not a birth time.
    *birth = 0;
#endif
    return 0;
}

// Spawns through PATH with the caller's stdio, cwd and environment and no other descriptors.
static int kotgent_spawn_inheriting(int *child, char *const argv[], int *actions_cleanup, int *attr_cleanup) {
    extern char **environ;
    *actions_cleanup = 0;
    *attr_cleanup = 0;
    posix_spawn_file_actions_t actions;
    int rc = posix_spawn_file_actions_init(&actions);
    if (rc) return rc;
    short flags = 0;
#ifdef __APPLE__
    flags |= POSIX_SPAWN_CLOEXEC_DEFAULT;
    for (int fd = 0; !rc && fd <= 2; fd++) rc = posix_spawn_file_actions_addinherit_np(&actions, fd);
#else
    typedef int (*closefrom_fn)(posix_spawn_file_actions_t *, int);
    closefrom_fn closefrom_action = (closefrom_fn)dlsym(RTLD_DEFAULT, "posix_spawn_file_actions_addclosefrom_np");
    rc = closefrom_action ? closefrom_action(&actions, 3) : ENOSYS;
#endif
    if (rc) {
        *actions_cleanup = posix_spawn_file_actions_destroy(&actions);
        return rc;
    }
    posix_spawnattr_t attr;
    rc = posix_spawnattr_init(&attr);
    if (!rc) {
        rc = posix_spawnattr_setflags(&attr, flags);
        if (!rc) rc = posix_spawnp(child, argv[0], &actions, &attr, argv, environ);
        *attr_cleanup = posix_spawnattr_destroy(&attr);
    }
    *actions_cleanup = posix_spawn_file_actions_destroy(&actions);
    return rc;
}

// Forwarding happens inside the handler with kill(2) alone, so it stays async-signal-safe whatever the Kotlin
// runtime is doing. The signal is recorded before the target is read, so one that lands before the child
// exists is replayed by kotgent_forward_to instead of being lost.
static volatile sig_atomic_t kotgent_forward_target_pid = 0;
static volatile sig_atomic_t kotgent_forward_last_signal = 0;
static const int kotgent_forwarded_signals[3] = { SIGINT, SIGTERM, SIGHUP };
static struct sigaction kotgent_forward_saved[3];
static int kotgent_forward_installed[3];

static void kotgent_forward_handler(int signo) {
    kotgent_forward_last_signal = signo;
    int pid = kotgent_forward_target_pid;
    if (pid > 0) kill((pid_t)pid, signo);
}

// A signal the caller ignores stays ignored, so the child inherits that disposition (nohup keeps working).
static int kotgent_forward_install(void) {
    kotgent_forward_target_pid = 0;
    kotgent_forward_last_signal = 0;
    struct sigaction action;
    memset(&action, 0, sizeof(action));
    action.sa_handler = kotgent_forward_handler;
    sigemptyset(&action.sa_mask);
    action.sa_flags = SA_RESTART;
    for (int i = 0; i < 3; i++) {
        kotgent_forward_installed[i] = 0;
        struct sigaction previous;
        if (sigaction(kotgent_forwarded_signals[i], (struct sigaction *)0, &previous) != 0) return -1;
        if (previous.sa_handler == SIG_IGN) continue;
        if (sigaction(kotgent_forwarded_signals[i], &action, &kotgent_forward_saved[i]) != 0) return -1;
        kotgent_forward_installed[i] = 1;
    }
    return 0;
}

static void kotgent_forward_to(int pid) {
    kotgent_forward_target_pid = pid;
    int pending = kotgent_forward_last_signal;
    if (pending) kill((pid_t)pid, pending);
}

static void kotgent_forward_restore(void) {
    for (int i = 0; i < 3; i++) {
        if (kotgent_forward_installed[i]) {
            sigaction(kotgent_forwarded_signals[i], &kotgent_forward_saved[i], (struct sigaction *)0);
        }
        kotgent_forward_installed[i] = 0;
    }
    kotgent_forward_target_pid = 0;
}
