# Kotlin/Native C interop for the PTY primitive (Task 2 spike).
#
# The Kotlin Toolchain auto-discovers cinterop/*.def (no YAML wiring). The generated
# bindings are importable from the package set below.
#
# Symbols exported for Pty.kt:
#   - openpty            (<util.h>)                -> allocate a master/slave pty pair
#   - posix_spawn + posix_spawn_file_actions_* + posix_spawnattr_* + POSIX_SPAWN_SETSID (<spawn.h>)
#   - ioctl / TIOCSWINSZ / struct winsize         (<sys/ioctl.h> -> <sys/ttycom.h>)
#   - termios                                     (<termios.h>)
#
# On macOS these all resolve via libSystem, so no extra linkerOpts are needed
# (openpty lives in libutil, which is part of libSystem). If linking ever fails,
# add:  linkerOpts = -lutil

package = io.kotgent.cinterop.pty
headers = util.h sys/ioctl.h termios.h spawn.h

---

#include <util.h>
#include <sys/ioctl.h>
#include <termios.h>
#include <spawn.h>

// openpty() lives in <util.h>. cinterop's header scan does not pick up util.h's
// declarations here (only spawn.h/ioctl.h/termios.h symbols come through), so we expose
// openpty through a compiled helper in this body instead -- the body IS compiled against
// util.h, so the call resolves even though the scan skipped it. Allocates a master/slave
// pty pair with default termios and window size. Returns 0 on success, -1 on error.
static int kotgent_openpty(int *amaster, int *aslave) {
    return openpty(amaster, aslave, (char *)0, (struct termios *)0, (struct winsize *)0);
}

// Set the window size on a pty master fd. This wraps the ioctl(TIOCSWINSZ) call and
// the struct winsize construction so Kotlin never has to deal with the variadic ioctl
// signature or the _IOW()-expanded TIOCSWINSZ macro. Returns 0 on success, -1 on error
// (errno set). Used by both Pty.open() (initial size) and Pty.resize().
static int kotgent_set_winsize(int fd, unsigned short rows, unsigned short cols) {
    struct winsize ws;
    ws.ws_row = rows;
    ws.ws_col = cols;
    ws.ws_xpixel = 0;
    ws.ws_ypixel = 0;
    return ioctl(fd, TIOCSWINSZ, &ws);
}

// --- Local controlling-tty helpers for `kotgent attach` raw passthrough (Task 15) ---------------
//
// These wrap termios/ioctl so Kotlin never has to materialize a `struct termios` or `struct winsize`
// (neither type is surfaced by cinterop's header scan; only the compiled body below sees them). The
// saved termios lives in C as a single process-wide value — there is exactly one controlling tty per
// `kotgent attach`, so a global is sufficient and keeps the Kotlin side free of the opaque struct.

static struct termios kotgent_saved_termios;
static int kotgent_saved_termios_valid = 0;

// Save fd's current termios, then switch it to raw mode (cfmakeraw). Returns 0 on success, -1 on error.
static int kotgent_tty_enter_raw(int fd) {
    if (tcgetattr(fd, &kotgent_saved_termios) != 0) return -1;
    kotgent_saved_termios_valid = 1;
    struct termios raw = kotgent_saved_termios;
    cfmakeraw(&raw);
    return tcsetattr(fd, TCSANOW, &raw);
}

// Restore the termios saved by kotgent_tty_enter_raw. Returns 0 if nothing was saved (no-op) or on
// success, -1 on error. Safe to call unconditionally on exit.
static int kotgent_tty_restore(int fd) {
    if (!kotgent_saved_termios_valid) return 0;
    return tcsetattr(fd, TCSAFLUSH, &kotgent_saved_termios);
}

// Read fd's current window size (ioctl TIOCGWINSZ) into *rows/*cols. Returns 0 on success, -1 on error.
static int kotgent_get_winsize(int fd, unsigned short *rows, unsigned short *cols) {
    struct winsize ws;
    if (ioctl(fd, TIOCGWINSZ, &ws) != 0) return -1;
    *rows = ws.ws_row;
    *cols = ws.ws_col;
    return 0;
}
